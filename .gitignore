# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Personal profile data — everything under profiles/ except _example/
profiles/*
!profiles/_example/
!profiles/_example/**

# Shared master pool (candidate-adjacent data)
data/
data

# Wizard / migration state
.stage*/
**/.stage*/
.gmail-state/
**/.gmail-state/
.gmail-tokens/
**/.gmail-tokens/
.indeed-state/
**/.indeed-state/

# Generated artifacts
*.tsv
!profiles/_example/**/*.tsv
*.pdf
*.docx
!**/node_modules/**/*.pdf
!**/node_modules/**/*.docx

# JD cache
**/jd_cache/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.cursor/
# .claude/ — ignore everything by default (worktrees, local settings,
# caches), but re-include subagent definitions so the SKILL-driven
# pipeline survives a fresh clone / new worktree (BL-123). Note: we
# can't use `.claude/` (directory form) here because git won't let us
# re-include children of an already-ignored parent — `.claude/*` only
# matches direct children, leaving `agents/` reachable.
.claude/*
!.claude/agents/
!.claude/agents/**
# Project-level hook registration must survive a fresh clone too (RFC 065):
# `settings.json` is the shared, committed layer; `settings.local.json`
# stays ignored because it holds per-user permissions.
!.claude/settings.json

# Obsidian: commit baseline config, ignore volatile per-user state
.obsidian/workspace*.json
.obsidian/graph.json
.obsidian/cache
.obsidian/plugins/*/data.json
**/.obsidian/workspace*.json
**/.obsidian/graph.json
**/.obsidian/cache
**/.obsidian/plugins/*/data.json

# Local one-off / investigation scripts (convention: leading underscore)
scripts/_*.js

# Test / coverage
coverage/
.nyc_output/

# Private notes and docs
CLAUDE.local.md
audit_*.md
# Note: BACKLOG.md now lives under private/BACKLOG.md (RFC 018 §3),
# already covered by the `private/` rule below.

# Private maintainer tree (RFC 018) — backlog files, handoffs, pre-anonymization originals
# Both forms: `private/` is the real directory in the main checkout, bare `private`
# is the symlink the SessionStart hook creates inside each worktree (same reason
# `data` is listed twice above).
private/
private

# Personal resume drafts / tailoring outputs (resume-tailor skill, manual edits)
docs/resume/

# Build artifacts
dist/
build/

# Obsidian editor state — local only (decided 2026-07-23)
.obsidian/
**/.obsidian/
