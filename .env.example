# ============================================
# AI Job Searcher — environment variables
# Format: {PROFILE_ID_UPPERCASE}_{SERVICE}_{KEY}
# Copy this file to .env and fill in values for your profile(s).
# Add a block per profile you create.
# ============================================

# --- profile: me ---
ME_NOTION_TOKEN=
ME_USAJOBS_API_KEY=
ME_USAJOBS_EMAIL=
# Gmail IMAP (RFC 021): generate an app-password at
# https://myaccount.google.com/apppasswords (requires 2FA).
ME_GMAIL_USER=
ME_GMAIL_APP_PASSWORD=
# Adzuna keyword-search adapter (discovery:adzuna). Free tier, no credit card:
# register at https://developer.adzuna.com/ and copy the "Application ID" +
# "Application Key". The adapter reads APP_ID + API_KEY (prefix stripped).
ME_ADZUNA_APP_ID=
ME_ADZUNA_API_KEY=
