{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/interview-coach/scripts/hooks/prep_gate.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/interview-coach/scripts/hooks/debrief_reminder.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/skills/interview-coach/scripts/hooks/prep_freeze_guard.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
