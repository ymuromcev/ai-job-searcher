#!/usr/bin/env bash
#
# pre-commit — PII + secret leak guard + doc-update gate.
#
# Runs against the staged diff only. Exits non-zero if any pattern matches,
# with a hint on what to do. Bypass (discouraged) with `git commit --no-verify`.

set -u

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED" ]; then
  exit 0
fi

# Only scan text-ish files. Skip binaries, generated artifacts, node_modules.
FILES=""
for f in $STAGED; do
  case "$f" in
    node_modules/*|dist/*|build/*|coverage/*) continue ;;
    *.pdf|*.docx|*.xlsx|*.png|*.jpg|*.jpeg|*.gif|*.ico) continue ;;
    *.lock|package-lock.json|yarn.lock|pnpm-lock.yaml) continue ;;
    # The hook file itself contains the PII regex patterns literally.
    # Self-exclude to avoid false positives on hook edits.
    .git-hooks/pre-commit) continue ;;
  esac
  if [ -f "$f" ]; then
    FILES="$FILES $f"
  fi
done

if [ -z "$FILES" ]; then
  exit 0
fi

FAIL=0
report() {
  if [ "$FAIL" -eq 0 ]; then
    echo ""
    echo "pre-commit: potential leak detected in staged changes."
    echo "-------------------------------------------------------"
  fi
  FAIL=1
  echo ""
  echo "[$1]"
  echo "$2"
}

# --- Secret patterns --------------------------------------------------------
# Notion integration tokens (ntn_ + 50 chars, case-insensitive).
HIT=$(git diff --cached -U0 -- $FILES | grep -iE '^\+.*\bntn_[a-z0-9]{40,}\b' || true)
[ -n "$HIT" ] && report "Notion token (ntn_...)" "$HIT"

# Legacy Notion secret tokens.
HIT=$(git diff --cached -U0 -- $FILES | grep -iE '^\+.*\bsecret_[a-z0-9]{40,}\b' || true)
[ -n "$HIT" ] && report "Legacy Notion token (secret_...)" "$HIT"

# Google OAuth client secrets.
HIT=$(git diff --cached -U0 -- $FILES | grep -E '^\+.*GOCSPX-[A-Za-z0-9_-]{20,}' || true)
[ -n "$HIT" ] && report "Google OAuth client secret" "$HIT"

# Generic "API key" style assignments with long opaque values.
HIT=$(git diff --cached -U0 -- $FILES | grep -iE '^\+.*(api[_-]?key|apikey|access[_-]?token|refresh[_-]?token|bearer)[[:space:]]*[:=][[:space:]]*["'\''`][A-Za-z0-9_\-]{24,}["'\''`]' || true)
[ -n "$HIT" ] && report "API key / token assignment" "$HIT"

# Private key blocks.
HIT=$(git diff --cached -U0 -- $FILES | grep -E '^\+.*-----BEGIN ((RSA|EC|OPENSSH|DSA) )?PRIVATE KEY-----' || true)
[ -n "$HIT" ] && report "Private key block" "$HIT"

# AWS-style access keys.
HIT=$(git diff --cached -U0 -- $FILES | grep -E '^\+.*\bAKIA[0-9A-Z]{16}\b' || true)
[ -n "$HIT" ] && report "AWS access key id" "$HIT"

# --- PII patterns -----------------------------------------------------------
# Author's real first name + surname. Poor-man's word boundary: allows the
# public handle `ymuromcev` through (it contains `muromcev` but preceded by
# `y`, a letter, so the `[^a-z]` boundary fails) while blocking `Muromcev`,
# `Yaroslav`, `Iaroslav` as standalone tokens. The `+` at line start counts
# as a non-letter boundary via the optional `(.*[^a-z])?` prefix, so a bare
# `+Iaroslav` is still caught.
HIT=$(git diff --cached -U0 -- $FILES | grep -iE '^\+(.*[^a-z])?(muromcev|muromtsev|yaroslav|iaroslav)([^a-z]|$)' || true)
[ -n "$HIT" ] && report "Real name leak" "$HIT"

# Secondary profile real names (edit to match your own if you fork).
HIT=$(git diff --cached -U0 -- $FILES | grep -iE '^\+(.*[^a-z])?(chirova|khrystyna)([^a-z]|$)' || true)
[ -n "$HIT" ] && report "Secondary profile real name" "$HIT"

# --- Committed .env ---------------------------------------------------------
for f in $FILES; do
  case "$f" in
    .env|.env.*)
      if [ "$f" != ".env.example" ]; then
        report "Committing .env file" "$f — .env is gitignored for a reason."
      fi
      ;;
  esac
done

# --- Doc-update gate --------------------------------------------------------
# When a NEW adapter (engine/modules/discovery/X.js, not _helpers, not tests,
# not index.js) or a NEW command (engine/commands/X.js, not tests) is added,
# both README.md AND docs/architecture/overview.md must be staged in the same
# commit. The adapter/command tables there are user-facing inventory and rot
# fast otherwise (see CLAUDE.md — "README как живая документация").
ADDED=$(git diff --cached --name-only --diff-filter=A)
NEW_ADAPTERS=""
NEW_COMMANDS=""
for f in $ADDED; do
  case "$f" in
    engine/modules/discovery/_*.js) ;;
    engine/modules/discovery/*.test.js) ;;
    engine/modules/discovery/index.js) ;;
    engine/modules/discovery/*.js) NEW_ADAPTERS="$NEW_ADAPTERS $f" ;;
    engine/commands/*.test.js) ;;
    engine/commands/*.js) NEW_COMMANDS="$NEW_COMMANDS $f" ;;
  esac
done

if [ -n "$NEW_ADAPTERS$NEW_COMMANDS" ]; then
  README_STAGED=$(echo "$STAGED" | grep -E '^README\.md$' || true)
  OVERVIEW_STAGED=$(echo "$STAGED" | grep -E '^docs/architecture/overview\.md$' || true)
  if [ -z "$README_STAGED" ] || [ -z "$OVERVIEW_STAGED" ]; then
    MSG="new code under engine/{discovery,commands}/ without doc updates."
    [ -n "$NEW_ADAPTERS" ] && MSG="$MSG"$'\n'"  new adapters:$NEW_ADAPTERS"
    [ -n "$NEW_COMMANDS" ] && MSG="$MSG"$'\n'"  new commands:$NEW_COMMANDS"
    [ -z "$README_STAGED" ] && MSG="$MSG"$'\n'"  missing: README.md (adapter/command table + dir-tree)"
    [ -z "$OVERVIEW_STAGED" ] && MSG="$MSG"$'\n'"  missing: docs/architecture/overview.md (inventory table)"
    MSG="$MSG"$'\n'"  update both, or land a separate docs: commit before push."
    report "Doc-update gate" "$MSG"
  fi
fi

# --- CHANGELOG gate (BL-97) -------------------------------------------------
# Any behavioral change under engine/ requires a CHANGELOG.md update in the
# same commit. Test-only edits (*.test.js) are skipped — adding a test does
# not change behavior. Bypass with `git commit --no-verify` for trivial /
# chore commits where a CHANGELOG entry would be noise.
ENGINE_BEHAVIORAL=""
for f in $STAGED; do
  case "$f" in
    engine/*.test.js|engine/**/*.test.js) ;;
    engine/*) ENGINE_BEHAVIORAL="$ENGINE_BEHAVIORAL $f" ;;
  esac
done

if [ -n "$ENGINE_BEHAVIORAL" ]; then
  CHANGELOG_STAGED=$(echo "$STAGED" | grep -E '^CHANGELOG\.md$' || true)
  if [ -z "$CHANGELOG_STAGED" ]; then
    MSG="behavioral change in engine/ without CHANGELOG.md update."
    MSG="$MSG"$'\n'"  changed:$ENGINE_BEHAVIORAL"
    MSG="$MSG"$'\n'"  add an entry under [Unreleased] in CHANGELOG.md and re-stage."
    MSG="$MSG"$'\n'"  trivial / chore? bypass with 'git commit --no-verify'."
    report "CHANGELOG gate" "$MSG"
  fi
fi

# --- KNOWN_COMMANDS ↔ cli.md sync (BL-98) -----------------------------------
# When engine/cli.js or docs/reference/cli.md changes, every command listed in
# the KNOWN_COMMANDS const array must have a matching `### <name>` heading in
# the CLI reference. Catches the case where a new command ships in code
# without a docs entry. Uses staged blobs (`:path`) so the check matches what
# is about to be committed, not the working tree.
CLI_JS_STAGED=$(echo "$STAGED" | grep -E '^engine/cli\.js$' || true)
CLI_MD_STAGED=$(echo "$STAGED" | grep -E '^docs/reference/cli\.md$' || true)
if [ -n "$CLI_JS_STAGED" ] || [ -n "$CLI_MD_STAGED" ]; then
  # Read whichever side of the pair is in the index (if staged) or fall back
  # to HEAD. Both files exist, so :path resolves either way after the commit.
  CLI_JS_CONTENT=$(git show :engine/cli.js 2>/dev/null || git show HEAD:engine/cli.js 2>/dev/null || true)
  CLI_MD_CONTENT=$(git show :docs/reference/cli.md 2>/dev/null || git show HEAD:docs/reference/cli.md 2>/dev/null || true)

  # Extract command strings from the KNOWN_COMMANDS = [ ... ]; block.
  KNOWN_LIST=$(printf '%s\n' "$CLI_JS_CONTENT" \
    | awk '/const KNOWN_COMMANDS = \[/{flag=1; next} flag && /^\];/{flag=0} flag' \
    | grep -oE '"[a-z][a-z0-9_-]*"' \
    | tr -d '"' \
    | sort -u)

  # Extract `### name` heading slugs (first token after ###).
  DOC_LIST=$(printf '%s\n' "$CLI_MD_CONTENT" \
    | grep -E '^### ' \
    | awk '{print $2}' \
    | sort -u)

  MISSING=""
  for cmd in $KNOWN_LIST; do
    if ! printf '%s\n' "$DOC_LIST" | grep -qE "^${cmd}$"; then
      MISSING="$MISSING $cmd"
    fi
  done

  if [ -n "$MISSING" ]; then
    MSG="KNOWN_COMMANDS in engine/cli.js has commands without a docs entry."
    MSG="$MSG"$'\n'"  missing '### <name>' heading in docs/reference/cli.md for:$MISSING"
    MSG="$MSG"$'\n'"  add a section per command (see existing entries for shape)."
    report "CLI docs sync gate" "$MSG"
  fi
fi

# --- CLI args ↔ cli.md sync (BL-104 / RFC 041) ------------------------------
# Per-command flag-presence + literal-enum drift between engine/cli.js,
# engine/commands/*.js, and docs/reference/cli.md. BL-98 covers command-name
# granularity; this gate covers flag + enum granularity, the gap BL-80
# leaked through. The gate scopes itself by re-checking the staged file
# list — if no watched file is staged, it exits 0 immediately. Honors
# CLI_ARGS_GATE_MODE=warn during the warn-only migration window (RFC 041
# §7); the default flips to `block` in an immediate follow-up commit.
CLI_ARGS_RC=0
node scripts/check_cli_args_sync.js --pre-commit
CLI_ARGS_RC=$?
case "$CLI_ARGS_RC" in
  0)
    # pass / nothing watched.
    ;;
  2)
    # heuristic warning only — do not block.
    ;;
  *)
    # exit 1 (drift) or any other non-zero — fail the commit. The script
    # itself prints the structured message + bypass hint above.
    FAIL=1
    ;;
esac

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "-------------------------------------------------------"
  echo "If this is a false positive, inspect the diff above and"
  echo "bypass with 'git commit --no-verify'. Prefer fixing the"
  echo "diff."
  echo ""
  exit 1
fi

exit 0
